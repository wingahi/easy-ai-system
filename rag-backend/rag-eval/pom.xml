<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.wgh</groupId>
        <artifactId>rag-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>rag-eval</artifactId>
    <name>rag-eval</name>
    <description>评测模块 - 检索评测指标体系、标注与版本化评测数据集（只读调用知识库检索）</description>

    <dependencies>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-data</artifactId>
        </dependency>
        <!-- 评测查询上限等配置属性 -->
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-config</artifactId>
        </dependency>
        <!-- 评测只读调用知识库检索（RagRetrieveService / RetrievalOptions / RetrieveResult / RetrievalQuality） -->
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-kb</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ====== 测试依赖 ====== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 依赖方向约束：评测域只能向下依赖知识库/数据/配置，禁止依赖执行域、
                 调度层、公开访问适配层与接入层，也禁止反向依赖文档处理模块。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-eval-domain-boundary</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>com.wgh:rag-document</exclude>
                                        <exclude>com.wgh:rag-tool</exclude>
                                        <exclude>com.wgh:rag-chat</exclude>
                                        <exclude>com.wgh:rag-agent</exclude>
                                        <exclude>com.wgh:rag-workflow</exclude>
                                        <exclude>com.wgh:rag-agent-multi</exclude>
                                        <exclude>com.wgh:rag-execution</exclude>
                                        <exclude>com.wgh:rag-scheduler</exclude>
                                        <exclude>com.wgh:rag-public-access</exclude>
                                        <exclude>com.wgh:rag-controller</exclude>
                                        <exclude>com.wgh:rag-app</exclude>
                                    </excludes>
                                    <message>依赖方向约束：rag-eval 只允许依赖 rag-kb 及以下模块，禁止依赖执行域/调度层/公开访问/接入层。</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                    <useSystemClassLoader>false</useSystemClassLoader>
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
