<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.wgh</groupId>
        <artifactId>rag-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>rag-chat</artifactId>
    <name>rag-chat</name>
    <description>聊天模块 - RAG链路、记忆管理、工具调用</description>

    <dependencies>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-data</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-kb</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-tool</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-workflow</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-quota</artifactId>
        </dependency>
        <!-- RedisCommandPort：跨实例取消标记复用公开访问的 Redis 封装 -->
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-config</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-reactor</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ====== 测试依赖 ====== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 依赖方向约束：rag-chat 与 rag-agent-multi 并列，互不依赖；也不得依赖调度层。
                 仅新增本约束块，不改动 rag-chat 的 Java 代码（冻结区）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-execution-domain-order</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>com.wgh:rag-agent-multi</exclude>
                                        <exclude>com.wgh:rag-scheduler</exclude>
                                    </excludes>
                                    <message>依赖方向约束：rag-chat 禁止直接依赖 rag-agent-multi / rag-scheduler。</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 测试插件（与 rag-agent-multi 保持一致） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                    <useSystemClassLoader>false</useSystemClassLoader>
                    <!-- Byte Buddy 支持 Java 25（Mockito 需重新转换普通类） -->
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
