<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.wgh</groupId>
        <artifactId>rag-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>rag-kb</artifactId>
    <name>rag-kb</name>
    <description>RAG知识库模块 - 知识库、文件、分割、向量化、检索</description>

    <dependencies>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-data</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-storage</artifactId>
        </dependency>
        <!-- RedisCommandPort / RedisDistributedLock：存储迁移任务状态与跨实例单飞 -->
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-llm</artifactId>
        </dependency>
        <!-- URL 数据源抓取的 SSRF 校验走 rag-common.net.SsrfGuard，不再依赖 rag-tool -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-pgvector</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.5</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.4</version>
        </dependency>
        <!-- HTML 解析（pptx 复用 POI，json 复用 Jackson） -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.3</version>
        </dependency>
        <!-- EML 邮件解析（Jakarta Mail 实现，API 由 Boot BOM 管理） -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>jakarta.mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ====== 测试依赖 ====== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 依赖方向约束：rag-kb 是领域层，禁止反向依赖执行域（chat / agent / workflow / agent-multi）、
                 调度层与 rag-tool（SSRF 工具已下沉到 rag-common.net，见 P1）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-domain-layer-boundary</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>com.wgh:rag-tool</exclude>
                                        <exclude>com.wgh:rag-chat</exclude>
                                        <exclude>com.wgh:rag-agent</exclude>
                                        <exclude>com.wgh:rag-workflow</exclude>
                                        <exclude>com.wgh:rag-agent-multi</exclude>
                                        <exclude>com.wgh:rag-scheduler</exclude>
                                    </excludes>
                                    <message>依赖方向约束：rag-kb 禁止直接依赖 rag-tool / rag-chat / rag-agent / rag-workflow / rag-agent-multi / rag-scheduler。</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 测试插件（与 rag-app 保持一致） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                    <useSystemClassLoader>false</useSystemClassLoader>
                    <!-- Byte Buddy 支持 Java 25（Mockito 需重新转换普通类） -->
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
