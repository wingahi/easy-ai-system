<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.wgh</groupId>
        <artifactId>rag-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>rag-agent</artifactId>
    <name>rag-agent</name>
    <description>Agent 编排模块 - Plan-and-Execute + 反思循环 + 状态持久化</description>

    <dependencies>
        <!-- rag-agent 是 rag-chat 的上游（Agent 编排器被 RagChatService 调用） -->
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-llm</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-kb</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wgh</groupId>
            <artifactId>rag-tool</artifactId>
        </dependency>

        <!-- LangChain4j 核心 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-reactor</artifactId>
        </dependency>

        <!-- 数据库 + JSONB 支持 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>
</project>
