# ============================================================
# 容器化部署环境变量示例：cp .env.example .env 后按需修改
# 生产环境必须通过密钥管理系统注入，禁止提交真实密钥
# ============================================================

# ---- 运行环境 ----
WGH_PROFILE=prod
WGH_BACKEND_PORT=8080
WGH_FRONTEND_PORT=8088
WGH_MANAGEMENT_PORT=9090

# ---- PostgreSQL（compose 内置 postgres:5432，镜像 pgvector/pgvector:pg15）----
# 唯一真相：POSTGRES_*；backend 的 SPRING_DATASOURCE_* 由它们派生
# 切外部库：把 POSTGRES_HOST/PORT/DB/USER/PASSWORD 改成外部实例，且不要启动 postgres 服务
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wgh_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
PROD_DB_POOL_MAX=50
WGH_PGVECTOR_SKIP_EXT=false

# ---- 外部库/裸机运行（可选，仅非 compose 时生效）----
# 优先级：SPRING_DATASOURCE_* > PROD_DB_* > application-prod.yml 默认值
# 直接 java -jar 运行 prod profile 时才需要这组变量
# PROD_DB_HOST=db.example.com
# PROD_DB_PORT=5432
# PROD_DB_NAME=wgh_rag
# PROD_DB_USERNAME=postgres
# PROD_DB_PASSWORD=

# ---- Redis（compose 内固定为服务名 redis）----
WGH_REDIS_PASSWORD=

# ---- 必填密钥 ----
# 本地会话 JWT 签名密钥，至少 32 字节；生产必须替换
WGH_AUTH_LOCAL_JWT_SECRET=
# 兼容 prod profile 的旧配置项，建议与上面保持同一取值
WGH_JWT_SECRET=
# 初始管理员口令；仅在库中不存在 admin 时用于创建，禁止使用默认口令
WGH_INIT_ADMIN_PASSWORD=

# ---- 外部 OIDC（不使用可留空）----
WGH_OIDC_ISSUER=
WGH_OIDC_AUDIENCE=
WGH_OIDC_JWKS_URI=

# ---- JVM ----
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:MaxMetaspaceSize=256m

# ---- 监控栈 ----
WGH_PROMETHEUS_PORT=9091
WGH_GRAFANA_PORT=3000
WGH_GRAFANA_ADMIN_USER=admin
WGH_GRAFANA_ADMIN_PASSWORD=admin
