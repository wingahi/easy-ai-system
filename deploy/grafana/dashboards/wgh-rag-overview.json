{
  "uid": "wgh-rag-overview",
  "title": "WGH RAG 业务总览",
  "tags": ["wgh-rag", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "对话请求 QPS",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(rate(wgh_chat_requests_total[$__rate_interval]))", "legendFormat": "QPS"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2}, "overrides": []}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "检索命中率（5m）",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(rate(wgh_retrieval_hits_total{hit=\"true\"}[$__rate_interval])) / clamp_min(sum(rate(wgh_retrieval_hits_total[$__rate_interval])), 1e-9)", "legendFormat": "hit ratio"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "decimals": 3}, "overrides": []}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "LLM 成本速率（元/分钟）",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(rate(wgh_llm_cost_total[$__rate_interval])) * 60", "legendFormat": "cost"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "currencyCNY", "decimals": 4}, "overrides": []}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "限流拒绝（5m）",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(increase(wgh_rate_limit_rejected_total[$__rate_interval]))", "legendFormat": "rejected"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "对话请求按路由 / 分享态",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [{"refId": "A", "expr": "sum by (route, share) (rate(wgh_chat_requests_total[$__rate_interval]))", "legendFormat": "{{route}} / share={{share}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "对话耗时与首 Token 延迟 P95",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(wgh_chat_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "duration p95 {{route}}"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(wgh_chat_first_token_seconds_bucket[$__rate_interval])))", "legendFormat": "first token p95 {{route}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "对话错误按阶段",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "targets": [{"refId": "A", "expr": "sum by (stage) (rate(wgh_chat_errors_total[$__rate_interval]))", "legendFormat": "{{stage}}"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "检索耗时 P95（hybrid / rerank）",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, hybrid, rerank) (rate(wgh_retrieval_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "hybrid={{hybrid}} rerank={{rerank}}"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "LLM Token 用量 / 调用次数",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "targets": [
        {"refId": "A", "expr": "sum by (type) (rate(wgh_llm_tokens_total[$__rate_interval]))", "legendFormat": "tokens {{type}}"},
        {"refId": "B", "expr": "sum by (provider) (rate(wgh_llm_calls_total[$__rate_interval]))", "legendFormat": "calls {{provider}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "工作流运行结果与节点失败",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
      "targets": [
        {"refId": "A", "expr": "sum by (status) (rate(wgh_workflow_runs_total[$__rate_interval]))", "legendFormat": "run {{status}}"},
        {"refId": "B", "expr": "sum by (nodeType) (rate(wgh_workflow_node_failures_total[$__rate_interval]))", "legendFormat": "node failure {{nodeType}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    }
  ]
}
