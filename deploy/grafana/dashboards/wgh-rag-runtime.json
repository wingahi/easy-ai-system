{
  "uid": "wgh-rag-runtime",
  "title": "WGH RAG 运行时与实例",
  "tags": ["wgh-rag", "jvm", "http"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {"id": 1, "type": "row", "title": "JVM", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "collapsed": false, "panels": []},
    {
      "id": 2,
      "type": "timeseries",
      "title": "堆内存使用 / 上限",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "targets": [
        {"refId": "A", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "used"},
        {"refId": "B", "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "max"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GC 暂停速率（秒/秒）与平均暂停",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
      "targets": [
        {"refId": "A", "expr": "sum(rate(jvm_gc_pause_seconds_sum[$__rate_interval])) / clamp_min(sum(rate(jvm_gc_pause_seconds_count[$__rate_interval])), 1e-9)", "legendFormat": "avg pause"},
        {"refId": "B", "expr": "sum(rate(jvm_gc_pause_seconds_count[$__rate_interval]))", "legendFormat": "GC/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 4}, "overrides": []}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "线程状态",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "targets": [
        {"refId": "A", "expr": "sum by (state) (jvm_threads_states_threads)", "legendFormat": "{{state}}"},
        {"refId": "B", "expr": "jvm_threads_live_threads", "legendFormat": "live"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "进程 CPU 使用率",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
      "targets": [{"refId": "A", "expr": "process_cpu_usage", "legendFormat": "cpu"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 3}, "overrides": []}
    },

    {"id": 6, "type": "row", "title": "HTTP 服务", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17}, "collapsed": false, "panels": []},
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP 请求速率（按状态）",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"wgh-rag-backend\"}[$__rate_interval]))", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 3}, "overrides": []}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP P95 延迟（按 URI）",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"wgh-rag-backend\"}[$__rate_interval])))", "legendFormat": "{{uri}}"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 9,
      "type": "stat",
      "title": "HTTP 5xx 比例（5m）",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 26},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"wgh-rag-backend\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"wgh-rag-backend\"}[5m])), 1e-9)", "legendFormat": "5xx ratio"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.01}, {"color": "red", "value": 0.05}]}
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "HTTP 5xx 速率（5m）",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 7, "w": 6, "x": 6, "y": 26},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"wgh-rag-backend\",status=~\"5..\"}[5m]))", "legendFormat": "5xx/s"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 3}, "overrides": []}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Hikari 连接池",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 26},
      "targets": [
        {"refId": "A", "expr": "hikaricp_connections_active", "legendFormat": "active"},
        {"refId": "B", "expr": "hikaricp_connections_idle", "legendFormat": "idle"},
        {"refId": "C", "expr": "hikaricp_connections_pending", "legendFormat": "pending"},
        {"refId": "D", "expr": "hikaricp_connections_max", "legendFormat": "max"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []}
    },

    {"id": 12, "type": "row", "title": "实例与抓取", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 33}, "collapsed": false, "panels": []},
    {
      "id": 13,
      "type": "table",
      "title": "抓取目标状态",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 34},
      "targets": [{"refId": "A", "expr": "up{job=~\"wgh-rag-backend|wgh-rag-postgres-exporter|prometheus\"}", "format": "table", "instant": true}],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true}, "renameByName": {"job": "job", "instance": "instance", "Value": "up"}}}
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "left"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": [{"matcher": {"id": "byName", "options": "up"}, "properties": [{"id": "custom.cellOptions", "value": {"type": "color-background"}}]}]
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "JVM 运行时信息（按实例）",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 34},
      "targets": [
        {"refId": "A", "expr": "jvm_info", "format": "table", "instant": true},
        {"refId": "B", "expr": "process_uptime_seconds", "format": "table", "instant": true}
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true}, "renameByName": {"instance": "instance", "version": "jdk", "vendor": "vendor", "Value #B": "uptime_s"}}}
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "抓取耗时",
      "datasource": {"type": "prometheus", "uid": "wgh-prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 42},
      "targets": [{"refId": "A", "expr": "scrape_duration_seconds{job=~\"wgh-rag-backend|wgh-rag-postgres-exporter\"}", "legendFormat": "{{job}} {{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 4}, "overrides": []}
    }
  ]
}
